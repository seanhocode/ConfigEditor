<UserControl x:Class="ConfigEditor.Wpf.Views.SingleFileEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:model="clr-namespace:ConfigEditor.Wpf.Models"
             mc:Ignorable="d">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Margin="0,0,0,6" Text="{Binding SelectedFilePath}" TextWrapping="Wrap" />

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="180" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Row="0" Grid.ColumnSpan="3" Margin="0,0,0,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Row="0" Grid.ColumnSpan="4" Orientation="Horizontal" Margin="0,0,0,6">
                    <RadioButton Content="XML 結構" GroupName="EditorMode" Margin="0,0,16,0" VerticalAlignment="Center"
                                 IsChecked="{Binding IsNotPlainTextMode}" />
                    <RadioButton Content="純文字" GroupName="EditorMode" VerticalAlignment="Center"
                                 IsChecked="{Binding IsPlainTextMode}" />
                </StackPanel>

                <TextBox Grid.Row="1" Grid.Column="0" Height="30" Margin="0,0,8,0" VerticalContentAlignment="Center" Text="{Binding XmlSearchText, UpdateSourceTrigger=PropertyChanged}" />
                <Button Grid.Row="1" Grid.Column="1" Width="90" Height="30" Margin="0,0,8,0" Content="搜尋" Command="{Binding SearchXmlCommand}" />
                <Button Grid.Row="1" Grid.Column="2" Width="110" Height="30" Margin="0,0,8,0" Content="全部展開" Command="{Binding ExpandAllXmlCommand}" IsEnabled="{Binding IsNotPlainTextMode}" />
                <Button Grid.Row="1" Grid.Column="3" Width="110" Height="30" Content="全部收合" Command="{Binding CollapseAllXmlCommand}" IsEnabled="{Binding IsNotPlainTextMode}" />
            </Grid>

            <GroupBox Grid.Row="1" Grid.Column="0" Header="XML 結構">
                <Grid>
                    <TreeView x:Name="XmlTree"
                              Visibility="{Binding IsNotPlainTextMode, Converter={StaticResource BoolToVis}}"
                              ItemsSource="{Binding XmlRootNodes}"
                              SelectedItemChanged="XmlTree_OnSelectedItemChanged"
                              VirtualizingStackPanel.IsVirtualizing="True"
                              VirtualizingStackPanel.VirtualizationMode="Recycling"
                              ScrollViewer.CanContentScroll="True">
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                            </Style>
                        </TreeView.ItemContainerStyle>
                        <TreeView.Resources>
                            <HierarchicalDataTemplate DataType="{x:Type model:XmlElementNode}" ItemsSource="{Binding Children}">
                                <TextBlock Text="{Binding DisplayLabel}" />
                            </HierarchicalDataTemplate>
                            <DataTemplate DataType="{x:Type model:XmlCommentNode}">
                                <TextBlock Text="{Binding DisplayLabel}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontStyle="Italic" />
                            </DataTemplate>
                        </TreeView.Resources>
                    </TreeView>
                    <TextBox x:Name="PlainTextBox"
                             Visibility="{Binding IsPlainTextMode, Converter={StaticResource BoolToVis}}"
                             Text="{Binding PlainTextContent, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True" AcceptsTab="True"
                             FontFamily="Consolas" FontSize="12"
                             HorizontalScrollBarVisibility="Auto"
                             VerticalScrollBarVisibility="Auto" />
                </Grid>
            </GroupBox>

            <GridSplitter Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="{DynamicResource CardStrokeColorDefaultBrush}" />

            <ScrollViewer Grid.Row="1" Grid.Column="2" VerticalScrollBarVisibility="Auto"
                           IsEnabled="{Binding IsNotPlainTextMode}">
                <StackPanel>
                    <GroupBox Header="節點內容" Margin="0,0,0,8">
                        <Grid Margin="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Margin="0,0,0,4" Text="節點名稱" />
                            <TextBox Grid.Row="1" Height="30" Margin="0,0,0,8" Text="{Binding SelectedXmlNode.ElementName, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Grid.Row="2" Margin="0,0,0,4" Text="直接文字內容" />
                            <TextBox Grid.Row="2" Height="90" Margin="0,22,0,0" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Text="{Binding SelectedXmlNode.TextValue, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>
                    </GroupBox>

                    <GroupBox Header="屬性" Margin="0,0,0,8">
                        <Grid Margin="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0"
                                    Height="220"
                                    Padding="1"
                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="14">
                                <DataGrid AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          CanUserDeleteRows="False"
                                          BorderThickness="0"
                                          ItemsSource="{Binding SelectedXmlNode.Attributes}"
                                          SelectedItem="{Binding SelectedXmlAttribute}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="名稱" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="180" />
                                        <DataGridTextColumn Header="值" Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Border>

                            <StackPanel Grid.Row="1" Margin="0,8,0,0">
                                <TextBlock Text="新增屬性" Margin="0,0,0,4" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBox Grid.Column="0" Height="30" Margin="0,0,6,0" Text="{Binding NewAttributeName, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBox Grid.Column="1" Height="30" Margin="0,0,6,0" Text="{Binding NewAttributeValue, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button Grid.Column="2" Width="70" Height="30" Margin="0,0,6,0" Content="新增" Command="{Binding AddAttributeCommand}" />
                                    <Button Grid.Column="3" Width="70" Height="30" Content="刪除" Command="{Binding RemoveAttributeCommand}" />
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </GroupBox>

                    <GroupBox Header="節點新增/刪除">
                        <StackPanel Margin="8">
                            <TextBlock Text="子節點名稱" Margin="0,0,0,4" />
                            <TextBox Height="30" Margin="0,0,0,8" Text="{Binding NewChildElementName, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="子節點文字內容" Margin="0,0,0,4" />
                            <TextBox Height="60" Margin="0,0,0,8" AcceptsReturn="True" Text="{Binding NewChildTextValue, UpdateSourceTrigger=PropertyChanged}" />
                            <WrapPanel>
                                <Button Width="120" Height="30" Margin="0,0,8,0" Content="新增子節點" Command="{Binding AddChildNodeCommand}" />
                                <Button Width="120" Height="30" Content="刪除目前節點" Command="{Binding DeleteSelectedNodeCommand}" />
                            </WrapPanel>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="編輯註解" Visibility="{Binding SelectedXmlComment, Converter={StaticResource NullToVisibilityConverter}}">
                        <StackPanel Margin="8">
                            <TextBlock Text="註解內容" Margin="0,0,0,4" />
                            <TextBox Height="80" Margin="0,0,0,8" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Text="{Binding SelectedXmlComment.CommentText, UpdateSourceTrigger=PropertyChanged}" />
                            <WrapPanel>
                                <Button Width="120" Height="30" Margin="0,0,8,0" Content="刪除註解" Command="{Binding DeleteCommentCommand}" />
                                <Button Width="140" Height="30" Content="解除註解" Command="{Binding UncommentCommand}" />
                            </WrapPanel>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>

            <GroupBox Grid.Row="2" Grid.ColumnSpan="3" Header="搜尋結果（點擊可定位到 XML 樹）" Margin="0,8,0,0">
                <Border Padding="1"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="14">
                    <DataGrid AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              BorderThickness="0"
                              IsReadOnly="True"
                              ItemsSource="{Binding XmlSearchResults}"
                              SelectedItem="{Binding SelectedSearchResult}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="節點" Binding="{Binding ElementName}" Width="180" />
                            <DataGridTextColumn Header="路徑" Binding="{Binding Path}" Width="*" />
                            <DataGridTextColumn Header="摘要" Binding="{Binding Summary}" Width="2*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </GroupBox>
        </Grid>

        <DockPanel Grid.Row="2" Margin="0,8,0,0">
            <Button DockPanel.Dock="Right" Width="120" Height="30" Content="儲存檔案" Command="{Binding SaveCurrentFileCommand}" />
            <TextBlock VerticalAlignment="Center" Text="{Binding EditorStatus}" TextWrapping="Wrap" />
        </DockPanel>
    </Grid>
</UserControl>
